{
  "app": "npx tsx bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "tsconfig.json", "node_modules", "cdk.out"]
  },
  "context": {
    "//": "Deployment settings. The Google client id is not a secret (the secret itself lives in Secrets Manager under googleSecretName); keeping it here rather than passing -c on every deploy means the second, siteUrl pass can't accidentally drop the Google provider by omitting it.",
    "cognitoPrefix": "baseball-sicko",
    "domainName": "statcastsicko.com",
    "googleClientId": "68383070545-5nldhf2aldbek680br28qe78h3f8s6on.apps.googleusercontent.com",
    "googleSecretName": "baseball-sicko/google-oauth",

    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true
  }
}
